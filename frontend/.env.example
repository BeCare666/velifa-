# VELIFA Frontend — copier en `.env.local` (avec le point : Next.js ne lit pas `env.local`)
# Toute variable NEXT_PUBLIC_* est visible dans le navigateur : n'y mettez JAMAIS de secret.

# URL de l'API backend (avec /api/v1)
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
# URL publique du site (liens de rapport partagés)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudflare Turnstile (clé de SITE, publique). Vide = pas de CAPTCHA (développement uniquement).
# Clé de test Cloudflare qui passe toujours : 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Clerk (authentification)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Affichage du menu admin (confort uniquement : l'accès réel est vérifié par le backend)
NEXT_PUBLIC_ADMIN_EMAILS=
