# VELIFA Backend — copier en `.env` (avec le point : NestJS ne lit pas un fichier nommé `env`)

# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
# URL publique du frontend (liens de rapport, redirections paiement, CORS)
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ─── Administration ──────────────────────────────────────────────────────────
# Emails (vérifiés dans Clerk) autorisés sur /admin, séparés par des virgules. Vide = aucun admin.
ADMIN_EMAILS=
# Clé interne optionnelle pour scripts serveur → API admin (≥ 32 caractères, sinon désactivée).
# Ne jamais l'exposer au frontend. Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=

# ─── Base de données (TiDB Cloud / MySQL) ─────────────────────────────────────
DATABASE_URL=mysql://USER:PASSWORD@HOST:4000/velifa

# ─── Redis (Upstash ou local) ─────────────────────────────────────────────────
# Local : redis://localhost:6379   Upstash : rediss://default:TOKEN@HOST.upstash.io:6379
REDIS_URL=redis://localhost:6379

# ─── Google PageSpeed API ─────────────────────────────────────────────────────
# https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=

# ─── Captures d'écran (Browserless.io) ────────────────────────────────────────
BROWSERLESS_API_KEY=
BROWSERLESS_URL=https://chrome.browserless.io

# ─── Cloudinary (stockage des captures) ───────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Brevo (emails) ───────────────────────────────────────────────────────────
BREVO_API_KEY=
BREVO_TEMPLATE_ID=1
BREVO_FROM_EMAIL=rapports@velifa.io
BREVO_FROM_NAME=VELIFA

# ─── WhatsApp (contact commercial dans les rapports) ──────────────────────────
# Numéro international, chiffres uniquement (ex. 966500000000). Vide = lien de partage générique.
WHATSAPP_NUMBER=

# ─── Prospection (audit en lot, admin) ────────────────────────────────────────
# Écart entre deux audits de prospects, en ms (min 5000). Chaque audit = 2 requêtes PageSpeed
# + 1 capture Browserless. 30000 = 2 880 audits/jour max.
PROSPECT_AUDIT_INTERVAL_MS=30000

# ─── Plans et limites ─────────────────────────────────────────────────────────
# Prix, variantes Lemon Squeezy et limites (sites, API, widget) : table `plans`, modifiable dans
# le backoffice (Admin → Plans). Plus de variables d'environnement pour ces valeurs.

# ─── Sécurité ─────────────────────────────────────────────────────────────────
# Cloudflare Turnstile (clé SECRÈTE). Obligatoire en production (sinon les audits anonymes sont refusés).
# Clé de test Cloudflare qui passe toujours : 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=
JWT_SECRET=change_me_min_32_chars_random_string

# ─── Clerk (vérification des jetons utilisateurs) ─────────────────────────────
CLERK_SECRET_KEY=

# ─── Monitoring (Sentry) — vide en dev ────────────────────────────────────────
SENTRY_DSN=

# ─── Lemon Squeezy (paiements) ────────────────────────────────────────────────
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_PRO_VARIANT_ID=
LEMONSQUEEZY_BUSINESS_VARIANT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=

# NE PAS définir NODE_TLS_REJECT_UNAUTHORIZED=0 : cela désactive la vérification TLS de toutes les connexions.
